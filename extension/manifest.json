{
  "manifest_version": 3,
  "name": "Instagram Recommendation Blocker",
  "version": "0.2.0",
  "description": "Block Instagram For you, Reels viewer, and Explore discovery grids with toolbar switches.",
  "permissions": ["storage"],
  "host_permissions": ["*://*.instagram.com/*"],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Instagram Recommendation Blocker",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["*://*.instagram.com/*"],
      "js": [
        "content/home-for-you-block.js",
        "content/reels-viewer-block.js",
        "content/explore-discovery-block.js",
        "content/content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "instagram-recommendation-blocker@local.dev",
      "strict_min_version": "109.0"
    }
  }
}
